<!DOCTYPE html>
<html>
<head>
    <title>Day Display</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        h1 {
            font-size: 36px;
        }
    </style>
</head>
<body>
    <h1 id="day">Today is </h1>
    <script>
        const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        document.getElementById("day").textContent = `Today is ${days[new Date().getDay()]}`;
    </script>
</body>
</html>
